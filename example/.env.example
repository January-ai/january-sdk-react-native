# iOS Simulator. For Android Emulator, replace 127.0.0.1 with 10.0.2.2.
EXPO_PUBLIC_JANUARY_TOKEN_ENDPOINT=http://127.0.0.1:8787/api/january/token
EXPO_PUBLIC_DEMO_SESSION_TOKEN=january-local-demo
EXPO_PUBLIC_DEMO_END_USER_ID=january-sdk-demo-user

