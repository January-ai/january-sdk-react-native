# Works for the iOS Simulator and Android as-is: `yarn example android` forwards
# this port into the emulator or USB device.
EXPO_PUBLIC_JANUARY_TOKEN_ENDPOINT=http://127.0.0.1:8787/api/january/client-token
EXPO_PUBLIC_DEMO_END_USER_ID=january-sdk-demo-user

# Optional for a physical device or hosted development relay.
# EXPO_PUBLIC_DEMO_SESSION_TOKEN=your-relay-token

# Optional debug-only shortcut. Never commit or distribute a real API key.
# EXPO_PUBLIC_JANUARY_API_KEY=sk-your-local-development-key
